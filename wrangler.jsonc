{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a-share-dashboard",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/SKILL.md"
      ],
      "fallthrough": true
    }
  ]
}
